  "contrast_pairs": [
    {
      "fg": "color.action",
      "bg": "color.surface",
      "kind": "text",
      "note": "Primary actions render as red text on paper."
    }
  ],
  "notes": {
    "color.surface_inverse": {
      "derived": true,
      "note": "Swiss never inverts surfaces in the JSX; the inverse pair is Ink (#000000) with Paper (#FFFFFF) text."
    },
    "color.accent_foreground": {
      "derived": false,
      "note": "JSX contrast table: 'Ink on Accent red 3.6:1'. Red is never a fill in Swiss (always type or a 2px bar)."
    },
    "color.action": {
      "derived": false,
      "note": "Primary buttons are red text with no fill ('Send ->'); the action/surface text pair is declared in contrast_pairs."
    },
    "color.action_foreground": {
      "derived": false,
      "note": "Same as accent_foreground; red fills are forbidden, so this pair is theoretical."
    },
    "color.danger": {
      "derived": true,
      "note": "Swiss has one chromatic colour; danger reuses accent red #E3000B."
    },
    "color.danger_foreground": {
      "derived": true,
      "note": "Paper on red (4.9:1) rather than Ink (4.3:1)."
    },
    "color.success": {
      "derived": true,
      "note": "No status hues in Swiss: status is '●' + tracked uppercase label, so success/warning/info fill with Ink and rely on the label."
    },
    "color.warning": {
      "derived": true,
      "note": "See success."
    },
    "color.info": {
      "derived": true,
      "note": "See success."
    },
    "color.border_input": {
      "derived": false,
      "note": "Input is a 1px black top rule (JSX input.border-top 1px solid #000000)."
    },
    "color.focus_ring": {
      "derived": false,
      "note": "JSX selection model: 'Focus outline 2px solid #000000 offset 2px'."
    },
    "font.mono": {
      "derived": true,
      "note": "Swiss forbids a second family; mono falls back to Inter."
    }
  }
}
