    },
    "color.info": {
      "derived": true,
      "note": "Black pill with white text."
    },
    "color.focus_ring": {
      "derived": true,
      "note": "JSX removes outlines and defines no focus style. Pink (3.5:1 on cream) at the structural 3px width."
    },
    "border_width.focus": {
      "derived": true,
      "note": "Matches the 3px structural border width."
    },
