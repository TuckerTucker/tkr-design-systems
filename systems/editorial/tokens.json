  "notes": {
    "color.surface_selected": {
      "derived": false,
      "note": "JSX 'Paper Subtle' #F1ECDF — selected rows and the reply composer."
    },
    "color.surface_inverse": {
      "derived": true,
      "note": "Editorial never inverts in the JSX; the inverse pair is ink as fill with paper text."
    },
    "color.text_placeholder": {
      "derived": true,
      "note": "Live CSS: placeholder is text_primary at opacity 0.5."
    },
    "color.accent_foreground": {
      "derived": true,
      "note": "Burgundy is used as type and rules in the JSX, never as a fill; paper is the legible foreground."
    },
    "color.action": {
      "derived": false,
      "note": "'File Reply ->' is burgundy uppercase Inter text."
    },
    "color.action_foreground": {
      "derived": true,
      "note": "See accent_foreground."
    },
    "color.danger": {
      "derived": true,
      "note": "JSX 'Masthead Deep' #6B1623 — keeps destructive states in the burgundy family, distinct from the masthead accent."
    },
    "color.success": {
      "derived": true,
      "note": "No status hues in the JSX. Deep ink-green chosen to sit with the paper/ink palette (6.9:1 with paper text)."
    },
    "color.warning": {
      "derived": true,
      "note": "No status hues in the JSX. Ochre ink (5.4:1 with paper text)."
    },
    "color.info": {
      "derived": true,
      "note": "No status hues in the JSX. Ink-blue (8.3:1 with paper text)."
    },
    "color.border_input": {
      "derived": false,
      "note": "Search input is underlined with a 1px #D8CEB9 rule."
    },
    "color.focus_ring": {
      "derived": false,
      "note": "JSX selection model: 'Focus outline 2px solid #8B1E2D offset 2px'."
    },
    "radius.chrome": {
      "derived": false,
      "note": "JSX: radius 4 is 'Spec chrome' (the showcase panels); the app shell itself is 0."
    },
    "font.mono": {
      "derived": true,
      "note": "Editorial has no monospace family; code falls back to the Inter metadata face."
    },
    "type.body": {
      "derived": false,
      "note": "JSX 'body-lg' 15px — AI message body, the primary reading text. 13px italic replies are extras.type.reply."
    },
    "space.md": {
      "derived": true,
      "note": "Not named in JSX; 16px/24px are the recurring sidebar/main gutters."
    }
  }
