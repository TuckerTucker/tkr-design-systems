    "motion.fast": {
      "derived": false,
      "note": "JSX .riso-nav-btn (PortraitCarousel): 'transition: background 0.12s'; .snd send uses 'opacity 0.15s'. Both are fades that the rule riso-no-dissolve forbids ('riso cuts, it does not dissolve'). exit_ms 0 is derived: the JSX has no exit animations (React unmounts instantly) and riso cuts."
    },
    "motion.moderate": {
      "derived": false,
      "note": "JSX .ci list rows: 'fadeSlideUp 0.3s ease-out', 60ms stagger. exit_ms 0 derived (cut)."
    },
    "motion.slow": {
      "derived": false,
      "note": "JSX .mi messages: 'fadeSlideUp 0.4s ease-out', 80ms stagger: the one sanctioned motion (riso-no-dissolve). exit_ms 0 derived (cut)."
    },
